# ── 香港生活看板 部署环境配置 ──────────────────────────
# 复制此文件为 .env 后填入实际值：cp .env.example .env
# 注意：.env 已加入 .gitignore，不会被提交到版本库

# ── 服务器连接 ──
SERVER_HOST=your_server_ip
SERVER_USER=your_username
SERVER_PORT=22

# ── 网站域名 ──
SITE_DOMAIN=your-domain.com

# ── 服务器路径 ──
SCRAPER_DIR=/opt/kai-tak-scraper
WEB_DIR=/var/www/kai-tak-rental
DATA_DIR=/var/www/kai-tak-rental/data

# ── 日志路径 ──
SCRAPER_LOG=/var/log/kai-tak-scraper.log

# ── 家庭日程 API ──
# 写操作（新增/修改/删除）所需密钥，请填入一个足够长的随机串
# 生成示例：python3 -c "import secrets; print(secrets.token_urlsafe(24))"
SCHEDULE_API_KEY=your_long_random_secret
SCHEDULE_API_PORT=8902
